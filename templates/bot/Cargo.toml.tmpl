[package]
name = "{{name}}"
version = "0.1.0"
edition = "2024"
description = "Artemis-style (collector → strategy → executor) bot on alloy, scaffolded by para"

[dependencies]
alloy = { {{alloy_dep}}, features = ["provider-ws", "pubsub", "signer-local", "rpc-types"] }
anyhow = "1"
async-trait = "0.1"
clap = { version = "4", features = ["derive", "env"] }
futures = "0.3"
tokio = { version = "1", features = ["full"] }
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }
